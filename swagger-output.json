{
  "swagger": "2.0",
  "info": {
    "title": "API de Florae",
    "description": "Documentacion de la API REST de Florae",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "Escribe: Bearer <token> (el token se obtiene en /auth/login)"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Registra un cliente nuevo",
        "description": "Crea un usuario de tipo Cliente y devuelve un token JWT (el usuario inicia sesión automáticamente).",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Datos del registro",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "run": {
                  "type": "string",
                  "example": "191102207"
                },
                "nombre": {
                  "type": "string",
                  "example": "Camila"
                },
                "apellidos": {
                  "type": "string",
                  "example": "Reyes Soto"
                },
                "correo": {
                  "type": "string",
                  "example": "camila@gmail.com"
                },
                "contrasena": {
                  "type": "string",
                  "example": "clave123"
                },
                "region": {
                  "type": "string",
                  "example": "Región Metropolitana de Santiago"
                },
                "comuna": {
                  "type": "string",
                  "example": "Santiago"
                },
                "direccion": {
                  "type": "string",
                  "example": "Av. Siempre Viva 123, Santiago"
                },
                "fechaNacimiento": {
                  "type": "string",
                  "example": "1998-05-20"
                }
              },
              "required": [
                "run",
                "nombre",
                "apellidos",
                "correo",
                "contrasena",
                "region",
                "comuna",
                "direccion"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Usuario creado, devuelve token y usuario"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "409": {
            "description": "El correo o el RUN ya están registrados"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Inicia sesión",
        "description": "Valida las credenciales y devuelve un token JWT. Úsalo en el botón Authorize como: Bearer <token>",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Credenciales",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "correo": {
                  "type": "string",
                  "example": "marcelo.caceres@profesor.duoc.cl"
                },
                "contrasena": {
                  "type": "string",
                  "example": "admin"
                }
              },
              "required": [
                "correo",
                "contrasena"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Devuelve token y usuario"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Credenciales incorrectas"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Datos del usuario con sesión iniciada",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Token ausente, inválido o expirado"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/products/": {
      "get": {
        "tags": [
          "Productos"
        ],
        "summary": "Lista los productos",
        "description": "Devuelve todos los productos. Se puede filtrar por categoría. Es pública.",
        "parameters": [
          {
            "name": "categoria",
            "in": "query",
            "description": "interior, exterior, macetas, sustratos o herramientas",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Productos"
        ],
        "summary": "Crea un producto",
        "description": "Solo para administradores.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Datos del producto",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "codigo": {
                  "type": "string",
                  "example": "PL-009"
                },
                "nombre": {
                  "type": "string",
                  "example": "Helecho Boston"
                },
                "categoria": {
                  "type": "string",
                  "example": "interior"
                },
                "precio": {
                  "type": "number",
                  "example": 9990
                },
                "stock": {
                  "type": "number",
                  "example": 10
                },
                "stockCritico": {
                  "type": "number",
                  "example": 2
                },
                "descripcionCorta": {
                  "type": "string",
                  "example": "Helecho de hojas largas, ideal para colgar."
                },
                "descripcion": {
                  "type": "string",
                  "example": "Prefiere ambientes húmedos y luz indirecta."
                },
                "imagen": {
                  "type": "string",
                  "example": "/img/logo.png"
                }
              },
              "required": [
                "codigo",
                "nombre",
                "categoria",
                "precio",
                "stock"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Producto creado"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Token ausente, inválido o expirado"
          },
          "403": {
            "description": "El usuario no es administrador"
          },
          "409": {
            "description": "El código ya existe"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/products/{id}": {
      "get": {
        "tags": [
          "Productos"
        ],
        "summary": "Obtiene un producto por id",
        "description": "Es pública.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Producto no encontrado"
          }
        }
      },
      "put": {
        "tags": [
          "Productos"
        ],
        "summary": "Actualiza un producto",
        "description": "Solo para administradores.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Datos del producto",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "codigo": {
                  "type": "string",
                  "example": "PL-009"
                },
                "nombre": {
                  "type": "string",
                  "example": "Helecho Boston"
                },
                "categoria": {
                  "type": "string",
                  "example": "interior"
                },
                "precio": {
                  "type": "number",
                  "example": 9990
                },
                "stock": {
                  "type": "number",
                  "example": 10
                },
                "stockCritico": {
                  "type": "number",
                  "example": 2
                },
                "descripcionCorta": {
                  "type": "string",
                  "example": "Helecho de hojas largas, ideal para colgar."
                },
                "descripcion": {
                  "type": "string",
                  "example": "Prefiere ambientes húmedos y luz indirecta."
                },
                "imagen": {
                  "type": "string",
                  "example": "/img/logo.png"
                }
              },
              "required": [
                "codigo",
                "nombre",
                "categoria",
                "precio",
                "stock"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Token ausente, inválido o expirado"
          },
          "403": {
            "description": "El usuario no es administrador"
          },
          "404": {
            "description": "Producto no encontrado"
          },
          "409": {
            "description": "Conflict"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Productos"
        ],
        "summary": "Elimina un producto",
        "description": "Solo para administradores.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Token ausente, inválido o expirado"
          },
          "403": {
            "description": "El usuario no es administrador"
          },
          "404": {
            "description": "Producto no encontrado"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  }
}